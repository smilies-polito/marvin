void benchTaskFunction(void *pvParameters)
{
    TaskData_t *pTaskData = (TaskData_t *)pvParameters;

    switch(pTaskData->benchNum){
		case 0:
			pTaskData->outputValue = sha(pTaskData->golden);
			break;
		case 1:
			pTaskData->outputValue = dijkstra_wrap(pTaskData->golden);
			break;
		case 2:
			pTaskData->outputValue = qsort_wrap(pTaskData->golden);
			break;
		case 3:
			pTaskData->outputValue = search_wrap(pTaskData->golden);
			break;
		case 4:
			pTaskData->outputValue = rijndeal_wrap(pTaskData->golden);
			break;
		case 5:
			pTaskData->outputValue = basicmath(pTaskData->golden);
			break;
	dafault:
		pTaskData->outputValue = sha(pTaskData->golden);
	}

    // Simulate processing
    pTaskData->outputValue = basicmath(pTaskData->golden);

    // Notify the main task that this task has completed
    xTaskNotifyGive(xFITask);

    // Delete the task since it's done
    vTaskDelete(NULL);
}

int runAllTask(int golden)
{
    BaseType_t xResult;
    uint32_t ulNotifiedValue;

    // Create the tasks
    for (uint32_t i = 0; i < NUM_TASKS; i++)
    {
    	taskData[i].benchNum = i;
    	taskData[i].golden = golden;
        xResult = xTaskCreate(benchTaskFunction, "Task", 2048, (void *)&taskData[i], tskIDLE_PRIORITY + 1, &taskHandles[i]);
        if (xResult != pdPASS)
        {
            // Handle the error
        	return -1;
        }
    }

    // Wait for all tasks to finish
    for (uint32_t i = 0; i < NUM_TASKS; i++)
    {
        ulNotifiedValue = ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
        if (ulNotifiedValue == 0)
        {
            // Handle the timeout (shouldn't happen with portMAX_DELAY)
        	return -1;
        }
    }
    int corr = 1;
    if (golden == 0){
    	// All tasks have completed; process the results
		for (uint32_t i = 0; i < NUM_TASKS; i++)
		{
			if(taskData[i].outputValue != 1){
				corr = 0;
			}
		}
		char* pointer = (char*)0x40000008;
		if(corr){
			pointer[0] = 1; //correct
		}else{
			pointer[0] = 0;	//not correct
		}
    }
    return 1;
}

static void targetTask (int golden, int num_benchmark){
	switch(num_benchmark){
	case 0:
		bubbleSort();
		break;
	case 1:
		sha(golden);
		break;
	case 2:
		dijkstra_wrap(golden);
		break;
	case 3:
		qsort_wrap(golden);
		break;
	case 4:
		search_wrap(golden);
		break;
	case 5:
		rijndeal_wrap(golden);
		break;
	case 6:
		basicmath(golden);
		break;
	case 7:
		runAllTask(golden);
		break;
	dafault:
		bubbleSort();
	}
}

