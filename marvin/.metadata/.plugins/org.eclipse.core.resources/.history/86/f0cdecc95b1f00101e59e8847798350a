static void faultInjectorTask( void *pvParameters )
{

	int num_benchmark = 3;
	char* pointer_bench = (char*)0x4000000c;
	num_benchmark = (int)pointer_bench[0];
	//num_benchmark = 3;
	int feature = 1;
	char* pointer_feature = (char*)0x40000010;  // 0 = eventm 1 = memory
	feature = (int)pointer_feature[0];
	int golden_run = 0;
	int* pointer = (int*)0x40000000;
	int c = (int)pointer[0];
	//xil_printf("c: %d\n", c);
	if(c == 0){
		xil_printf("\n");
		char* pointer2 = (char*)0x40000004;
		int f = (int)pointer2[0];
		xil_printf("Fault %d:\n", f);
		int* pointer_seed = (int*)0x40000014;
		int seed = (int)pointer_seed[0];
		//xil_printf("Seed in main: %d\n", seed);
		if(seed >= 100){
			golden_run = seed;
		}else{
			golden_run = 1;
		}
	}
	if(feature == 0){
		if(golden_run == 0){
			confPMU(c);
		}
		targetTask(golden_run, num_benchmark);
		if(golden_run == 0){
			readPMU();
		}

	}else{
		memory_zero();
		targetTask(golden_run, num_benchmark);
		if(golden_run == 0){
			memory_dump();
		}
	}
	xil_printf(""); //solo per mettere final bp

	vTaskDelete( NULL );
}

